# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings > API).

# URL do projeto Supabase
SUPABASE_URL=

# service_role key (NUNCA exponha no cliente / NUNCA use o prefixo NEXT_PUBLIC_ nela)
SUPABASE_SERVICE_ROLE_KEY=

# Chave PIX que vai aparecer na tela de pagamento
PIX_KEY=
